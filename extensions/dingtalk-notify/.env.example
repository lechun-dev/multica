# 运行模式。local/mock 只在本地模拟，不会联系钉钉。
DINGTALK_NOTIFY_MODE=local/mock
DINGTALK_NOTIFY_ENABLED=false

# 启用 staging/production 时填写；密钥请放在本机 .env 或密钥管理器中。
DINGTALK_CLIENT_ID=CHANGE_ME
DINGTALK_CLIENT_SECRET=CHANGE_ME
DINGTALK_OAUTH_REDIRECT_URI=CHANGE_ME
DINGTALK_ROBOT_CODE=CHANGE_ME

# DATABASE_URL 使用项目根目录的同名配置；其他地址和重试参数使用代码默认值。
