# Runtime mode. local/mock never contacts DingTalk.
DINGTALK_NOTIFY_MODE=local/mock
DINGTALK_NOTIFY_ENABLED=false

# Reserved infrastructure values; fill these for staging/production.
APP_BASE_URL=CHANGE_ME
API_PUBLIC_URL=CHANGE_ME
DATABASE_URL=CHANGE_ME
REDIS_URL=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
SECRET_STORE_REF=CHANGE_ME
DEPLOY_ENV=local

# Existing DingTalk application values. Keep secrets in a secret manager.
DINGTALK_CLIENT_ID=CHANGE_ME
DINGTALK_CLIENT_SECRET=CHANGE_ME
DINGTALK_CORP_ID=CHANGE_ME
DINGTALK_OAUTH_REDIRECT_URI=CHANGE_ME
DINGTALK_AGENT_ID=CHANGE_ME
DINGTALK_ROBOT_CODE=CHANGE_ME
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_OAUTH_AUTH_URL=https://login.dingtalk.com/oauth2/auth
DINGTALK_OAUTH_TOKEN_URL=CHANGE_ME
DINGTALK_OAUTH_USER_URL=CHANGE_ME

# Worker controls. Empty values use safe in-process defaults.
DINGTALK_NOTIFY_WORKER_INTERVAL=5s
DINGTALK_NOTIFY_MAX_ATTEMPTS=5
