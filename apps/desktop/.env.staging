# Internal staging environment; not a public support environment.
# Used by `pnpm dev:desktop:staging` (`electron-vite dev --mode staging`).
# Personal overrides go in .env.staging.local.
VITE_API_URL=https://mission-staging.lechun.cc
VITE_WS_URL=wss://mission-staging.lechun.cc/ws

# VITE_APP_URL is the web app origin used for copy-link/open-in-browser URLs.
# This deployment routes Web, API, OAuth and WebSocket traffic through one
# public origin, so the app and API URLs intentionally share the same host.
VITE_APP_URL=https://mission-staging.lechun.cc
